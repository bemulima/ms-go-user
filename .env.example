APP_NAME=user-service
APP_ENV=local
APP_PUBLIC_URL=http://localhost:8000
APP_PORT=8080

DB_HOST=postgres
DB_PORT=5432
POSTGRES_HOST_PORT=5433
DB_USER=app
DB_PASSWORD=app_password
DB_NAME=userdb
DB_SSLMODE=disable

GORM_LOG_LEVEL=warn
DB_MIGRATE_ON_START=true

JWT_SECRET=change_me
JWT_TTL_MINUTES=60m
JWT_REFRESH_TTL_MINUTES=43200m
JWT_ISSUER=user-service
JWT_AUDIENCE=frontend

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=${APP_PUBLIC_URL}/auth/oauth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=${APP_PUBLIC_URL}/auth/oauth/github/callback

MS_TARANTOOL_URL=http://tarantool-microservice:8081
# RBAC origin only; the HTTP adapter supplies the provider API mount.
MS_RBAC=http://rbac-microservice:8082
FILESTORAGE_INTERNAL_TOKEN=
IMAGE_PROCESSOR_SERVICE_BASE_URL=
IMAGE_PROCESSOR_INTERNAL_TOKEN=

NATS_URL=nats://nats:4222
INTERNAL_API_TOKEN=change-me

NGINX_SERVER_NAME=localhost
NGINX_HOST_PORT=8000
CORS_ALLOW_ORIGINS=*
RATE_LIMIT_PER_MIN=120
